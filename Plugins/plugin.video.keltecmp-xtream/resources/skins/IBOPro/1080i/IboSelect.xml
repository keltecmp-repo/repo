<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
  <defaultcontrol always="true">500</defaultcontrol>
  <animation type="WindowOpen" reversible="false">
    <effect type="fade" start="0" end="100" time="200"/>
    <effect type="zoom" start="92" end="100" center="960,540" time="220" tween="back" easing="out"/>
  </animation>
  <animation type="WindowClose" reversible="false">
    <effect type="fade" start="100" end="0" time="140"/>
  </animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>ibo_white.png</texture>
      <colordiffuse>A6000000</colordiffuse>
    </control>
    <control type="image" id="10">
      <left>510</left><top>170</top><width>900</width><height>740</height>
      <texture border="16">ibo_dlg.png</texture>
    </control>
    <control type="label" id="11">
      <left>550</left><top>190</top><width>820</width><height>70</height>
      <font>font15_title</font>
      <textcolor>FFFFFFFF</textcolor>
      <align>center</align><aligny>center</aligny>
      <label>$INFO[Window.Property(ibo.sel_title)]</label>
    </control>
    <control type="image" id="12">
      <left>550</left><top>266</top><width>820</width><height>2</height>
      <texture>ibo_div.png</texture>
    </control>
    <control type="group" id="13">
      <left>510</left><top>170</top>
      <control type="list" id="500">
        <left>40</left><top>110</top><width>820</width><height>594</height>
        <orientation>vertical</orientation>
        <scrolltime>150</scrolltime>
        <onup>500</onup><ondown>500</ondown><onleft>500</onleft><onright>500</onright>
        <itemlayout height="66" width="820">
          <control type="image">
            <left>0</left><top>4</top><width>820</width><height>58</height>
            <texture border="16">ibo_pill.png</texture>
          </control>
          <control type="label">
            <left>26</left><top>4</top><width>520</width><height>58</height>
            <font>font13</font><textcolor>FFFFFFFF</textcolor>
            <align>left</align><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
          </control>
          <control type="label">
            <left>540</left><top>4</top><width>254</width><height>58</height>
            <font>font12</font><textcolor>FFB9B2C2</textcolor>
            <align>right</align><aligny>center</aligny>
            <label>$INFO[ListItem.Label2]</label>
          </control>
        </itemlayout>
        <focusedlayout height="66" width="820">
          <control type="image">
            <left>0</left><top>4</top><width>820</width><height>58</height>
            <texture border="16">ibo_pill_f.png</texture>
          </control>
          <control type="label">
            <left>26</left><top>4</top><width>520</width><height>58</height>
            <font>font13</font><textcolor>FFFFEB3B</textcolor>
            <align>left</align><aligny>center</aligny><scroll>true</scroll>
            <label>$INFO[ListItem.Label]</label>
          </control>
          <control type="label">
            <left>540</left><top>4</top><width>254</width><height>58</height>
            <font>font12</font><textcolor>FFFFFFFF</textcolor>
            <align>right</align><aligny>center</aligny>
            <label>$INFO[ListItem.Label2]</label>
          </control>
        </focusedlayout>
      </control>
    </control>
  </controls>
</window>
