<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
  <defaultcontrol always="false">-</defaultcontrol>
  <allowoverlay>no</allowoverlay>
  <animation type="WindowOpen" reversible="false">
    <effect type="fade" start="0" end="100" time="220"/>
  </animation>
  <animation type="WindowClose" reversible="false">
    <effect type="fade" start="100" end="0" time="180"/>
  </animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>$INFO[Window(Home).Property(loading.fanart)]</texture>
      <aspectratio>scale</aspectratio>
      <fadetime>300</fadetime>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>ibo_white.png</texture>
      <colordiffuse>D9140B1E</colordiffuse>
    </control>
    <control type="group">
      <left>560</left>
      <top>290</top>
      <animation type="WindowOpen" reversible="false">
        <effect type="zoom" start="90" end="100" center="400,220" time="260" tween="back" easing="out"/>
      </animation>
      <control type="image">
        <left>0</left><top>0</top><width>800</width><height>440</height>
        <texture border="16">ibo_dlg.png</texture>
      </control>
      <control type="image">
        <left>340</left><top>30</top><width>120</width><height>120</height>
        <texture>ibo_logo_mark.png</texture>
        <aspectratio>keep</aspectratio>
      </control>
      <control type="label">
        <left>40</left><top>158</top><width>720</width><height>50</height>
        <font>font15_title</font>
        <textcolor>FFFFFFFF</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$INFO[Window.Property(ibo.load_title)]</label>
      </control>
      <control type="image">
        <left>96</left><top>226</top><width>44</width><height>44</height>
        <texture>ibo_ic_reload.png</texture>
        <aspectratio>keep</aspectratio>
        <animation effect="rotate" start="0" end="-360" center="auto" time="1100" loop="true" condition="true">Conditional</animation>
      </control>
      <control type="label" id="200">
        <left>152</left><top>222</top><width>580</width><height>52</height>
        <font>font13</font>
        <textcolor>FFE6E6E6</textcolor>
        <align>left</align><aligny>center</aligny>
        <label>Carregando...</label>
      </control>
      <control type="progress" id="100">
        <left>60</left><top>306</top><width>680</width><height>16</height>
        <texturebg border="8">ibo_prog_bg.png</texturebg>
        <midtexture border="8">ibo_prog_fill.png</midtexture>
        <visible>!String.IsEmpty(Window.Property(ibo.load_bar))</visible>
      </control>
      <control type="label">
        <left>40</left><top>372</top><width>720</width><height>36</height>
        <font>font12</font>
        <textcolor>FFB9B2C2</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$INFO[Window.Property(ibo.load_hint)]</label>
        <visible>!String.IsEmpty(Window.Property(ibo.load_hint))</visible>
      </control>
    </control>
  </controls>
</window>
